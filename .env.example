DATABASE_URL=postgresql://hf:hf@127.0.0.1:5432/hf
TEST_DATABASE_URL=postgresql://hf:hf@127.0.0.1:5432/hf_test
WEB_TEST_DATABASE_URL=postgresql://hf:hf@127.0.0.1:5432/hf_test_web
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=hf-photos
S3_ACCESS_KEY=hfadmin
S3_SECRET_KEY=hfhfhfhf
S3_FORCE_PATH_STYLE=true
DEV_AUTH=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The address the factory's phones reach the app on, used to build the QR
# printed on operator ID cards. Read at request time, not baked into the build
# like NEXT_PUBLIC_*, so it can be set on the running server. Leave it blank and
# each card points at whatever address the admin issued it from, which is
# usually right — set it only when the admin and the phones use different names.
APP_URL=
DASHBOARD_TEST_DATABASE_URL=postgresql://hf:hf@127.0.0.1:5432/hf_test_dashboard
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3002

# Photo autofill on the phone (inventory receiving). Missing key = forms work without suggestions.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
