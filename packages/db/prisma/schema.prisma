generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

// A second client, for Cloudflare Workers only. One `prisma generate` produces
// both; @hf/db picks between them (see packages/db/src/index.ts).
//
// They differ in exactly one load-bearing way: how they reach the query
// compiler. The Node client above compiles it at runtime, from bytes, with
// `new WebAssembly.Module(Buffer.from(base64))`. workerd forbids compiling Wasm
// from bytes for the same reason it forbids eval — that is the
// "Wasm code generation disallowed by embedder" error every query there hit.
//
// `runtime = "workerd"` instead emits
// `import("./query_compiler_fast_bg.wasm?module")`. That is a BUNDLER
// specifier: `?module` is an instruction to the bundler, not something a
// runtime resolves, so it only becomes a real Wasm module if the bundler sees
// the import and emits the .wasm at build time. Node and Vitest cannot parse
// `?module` at all, which is why one client cannot serve both runtimes.
generator workerClient {
  provider = "prisma-client"
  output   = "../src/generated-workerd"
  runtime  = "workerd"
}

datasource db {
  provider = "postgresql"
}

enum OrgType {
  buyer
  agent
}

enum UserRole {
  admin
  store
  qa
  supervisor
  merchandiser
  management
}

/// Which kind of secret an `operator_codes` row holds.
///
/// `code` is the eight-character slip an operator types once on a bench phone.
/// `badge` is the long random token printed as a QR on their ID card, which a
/// phone camera opens as a URL — same table, same issue/revoke/audit trail,
/// different secret and different front door.
enum OperatorCredentialKind {
  code
  badge
}

enum WorkerType {
  cutter
  paster
  tailor
  finisher
}

enum Gender {
  mens
  womens
  unisex
  kids
}

enum Stage {
  cutting
  pasting
  stitching
  finishing
  qc
  packaging
}

enum PieceState {
  PLANNED
  CUT_PENDING_QA
  CUT_OK
  WITH_PASTING
  PASTED_PENDING_QA
  PASTE_OK
  WITH_STITCHING
  STITCHED_PENDING_QA
  STITCH_OK
  WITH_FINISHING
  FINISHED_PENDING_QA
  FINISH_OK
  QC_OK
  PACKED
  SHIPPED
  ON_HOLD
  REJECTED
  CANCELLED
}

enum PieceEventType {
  PIECE_ACTIVATED
  STAGE_QA_PASSED
  STAGE_QA_FAILED
  REWORK_ASSIGNED
  ISSUED
  RECEIVED
  FIRST_PIECE_APPROVED
  PIECE_HELD
  PIECE_RELEASED
  PIECE_REJECTED
  PIECE_REPLACED
  PIECE_CANCELLED
  COMPONENT_ADJUSTED
  CORRECTION
  LABEL_PRINT_REQUESTED
  LABEL_REPRINT_REQUESTED
  PACKED
  SHIPPED
}

enum LabelTemplate {
  t50x25
  t50x50
}

enum LabelKind {
  planned
  stage
}

enum ChecklistStep {
  activate
  qa
  issue
  receive
  pack
  ship
}

enum ChecklistItemKind {
  confirm
  photo
  materials
  measure
}

enum InventoryReceiptStatus {
  RECEIVED
  COUNTED
}

enum InventoryEventType {
  RECEIPT_RECORDED
  RECEIPT_COUNTED
}

enum AttachmentPurpose {
  goods
  place
  document
}

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      OrgType
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  buyerPrograms Program[] @relation("buyer")
  agentPrograms Program[] @relation("agent")
  ownedStyles   Style[]
  @@map("organizations")
}

model Program {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyerId   String   @map("buyer_id") @db.Uuid
  agentId   String?  @map("agent_id") @db.Uuid
  name      String
  season    String?
  createdAt DateTime @default(now()) @map("created_at")
  buyer  Organization  @relation("buyer", fields: [buyerId], references: [id])
  agent  Organization? @relation("agent", fields: [agentId], references: [id])
  orders Order[]
  checklists Checklist[]
  @@map("programs")
}

model Style {
  id                    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  styleCode             String  @unique @map("style_code")
  category              String
  gender                Gender
  ownerId               String? @map("owner_id") @db.Uuid
  description           String?
  active                Boolean @default(true)
  referenceAttachmentId String? @unique @map("reference_attachment_id") @db.Uuid
  owner               Organization?   @relation(fields: [ownerId], references: [id])
  lineItems           OrderLineItem[]
  referenceAttachment Attachment?     @relation(fields: [referenceAttachmentId], references: [id], onDelete: SetNull)
  @@map("styles")
}

model Order {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programId   String    @map("program_id") @db.Uuid
  orderNumber String    @map("order_number")
  dueDate     DateTime? @map("due_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")
  program   Program         @relation(fields: [programId], references: [id])
  lineItems OrderLineItem[]
  @@unique([programId, orderNumber])
  @@map("orders")
}

model OrderLineItem {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId  String @map("order_id") @db.Uuid
  styleId  String @map("style_id") @db.Uuid
  size     String
  shade    String
  quantity Int
  order  Order   @relation(fields: [orderId], references: [id])
  style  Style   @relation(fields: [styleId], references: [id])
  pieces Piece[]
  @@unique([orderId, styleId, size, shade])
  @@map("order_line_items")
}

model Piece {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lineItemId String     @map("line_item_id") @db.Uuid
  qrToken    String     @unique @map("qr_token")
  serial     Int
  state      PieceState @default(PLANNED)
  workerId   String?    @map("worker_id") @db.Uuid
  version    Int        @default(0)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  lineItem OrderLineItem @relation(fields: [lineItemId], references: [id])
  worker   Worker?       @relation(fields: [workerId], references: [id])
  events   PieceEvent[]
  labels   LabelPrint[]
  rejectedLineage    PieceLineage[] @relation("rejected")
  replacementLineage PieceLineage[] @relation("replacement")
  @@unique([lineItemId, serial])
  @@index([state])
  @@map("pieces")
}

model PieceEvent {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pieceId        String         @map("piece_id") @db.Uuid
  eventType      PieceEventType @map("event_type")
  stage          Stage?
  userId         String         @map("user_id") @db.Uuid
  workerId       String?        @map("worker_id") @db.Uuid
  groupId        String?        @map("group_id") @db.Uuid
  details        Json           @default("{}")
  createdAt      DateTime       @default(now()) @map("created_at")
  idempotencyKey String         @unique @map("idempotency_key")
  piece       Piece        @relation(fields: [pieceId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
  worker      Worker?      @relation(fields: [workerId], references: [id])
  attachments Attachment[]
  lineage     PieceLineage[]
  @@index([pieceId, createdAt])
  @@index([groupId])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("piece_events")
}

/// Which replacement was cut for which written-off piece.
///
/// @@unique([rejectedPieceId]) is the invariant, not an optimisation: a piece
/// is rejected once and replaced at most once. It is also the last line of
/// defence behind the route's replay guard - an idempotent retry physically
/// cannot insert a second replacement even if that guard were wrong.
model PieceLineage {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rejectedPieceId    String   @map("rejected_piece_id") @db.Uuid
  replacementPieceId String   @map("replacement_piece_id") @db.Uuid
  reason             String
  eventId            String   @map("event_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  rejectedPiece    Piece      @relation("rejected", fields: [rejectedPieceId], references: [id])
  replacementPiece Piece      @relation("replacement", fields: [replacementPieceId], references: [id])
  event            PieceEvent @relation(fields: [eventId], references: [id])
  @@unique([rejectedPieceId])
  @@map("piece_lineage")
}

model Attachment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pieceEventId String?  @map("piece_event_id") @db.Uuid
  storageKey   String   @unique @map("storage_key")
  mime         String
  bytes        Int
  takenById    String   @map("taken_by") @db.Uuid
  takenAt      DateTime @default(now()) @map("taken_at")
  confirmedAt  DateTime? @map("confirmed_at")
  inventoryReceiptId String?            @map("inventory_receipt_id") @db.Uuid
  purpose            AttachmentPurpose?
  event   PieceEvent? @relation(fields: [pieceEventId], references: [id])
  takenBy User        @relation(fields: [takenById], references: [id])
  styleReference Style?
  inventoryReceipt InventoryReceipt? @relation(fields: [inventoryReceiptId], references: [id], onDelete: SetNull)
  @@index([inventoryReceiptId])
  @@map("attachments")
}

model LabelPrint {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pieceId       String        @map("piece_id") @db.Uuid
  kind          LabelKind     @default(stage)
  stage         Stage?
  template      LabelTemplate
  requestedById String        @map("requested_by") @db.Uuid
  requestedAt   DateTime      @default(now()) @map("requested_at")
  exportBatchId String?       @map("export_batch_id") @db.Uuid
  printedAt     DateTime?     @map("printed_at")
  reprintReason String?       @map("reprint_reason")
  piece       Piece        @relation(fields: [pieceId], references: [id])
  requestedBy User         @relation(fields: [requestedById], references: [id])
  exportBatch ExportBatch? @relation(fields: [exportBatchId], references: [id])
  @@index([printedAt, kind, stage])
  @@map("label_prints")
}

model ExportBatch {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  format      String
  kind        LabelKind @default(stage)
  stage       Stage?
  labelCount  Int       @map("label_count")
  createdById String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  printedAt   DateTime? @map("printed_at")
  copies      Int?
  createdBy   User         @relation(fields: [createdById], references: [id])
  labels      LabelPrint[]
  @@map("export_batches")
}

/// One checklist per scope. `scopeKey` is the uniqueness key because Postgres
/// treats NULLs as distinct in a plain unique constraint: it is
/// `step|stage|category|programId` with empty strings for nulls, computed in
/// `scopeKey()` from @hf/domain and never anywhere else.
model Checklist {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  step      ChecklistStep
  stage     Stage?
  category  String
  programId String?       @map("program_id") @db.Uuid
  scopeKey  String        @unique @map("scope_key")
  createdAt DateTime      @default(now()) @map("created_at")
  program  Program?           @relation(fields: [programId], references: [id], onDelete: Restrict)
  versions ChecklistVersion[]
  @@index([programId])
  @@map("checklists")
}

/// A published version is immutable. The draft is the one version with a null
/// published_at; the partial unique index in the migration allows one per checklist.
model ChecklistVersion {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checklistId   String    @map("checklist_id") @db.Uuid
  number        Int
  publishedAt   DateTime? @map("published_at")
  publishedById String?   @map("published_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  checklist   Checklist       @relation(fields: [checklistId], references: [id])
  publishedBy User?           @relation(fields: [publishedById], references: [id])
  items       ChecklistItem[]
  @@unique([checklistId, number])
  @@map("checklist_versions")
}

model ChecklistItem {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId String            @map("version_id") @db.Uuid
  position  Int
  kind      ChecklistItemKind @default(confirm)
  textEn    String            @map("text_en")
  textHi    String            @map("text_hi")
  pictogram String
  unit      String?
  min       Decimal?          @db.Decimal(10, 2)
  max       Decimal?          @db.Decimal(10, 2)
  version ChecklistVersion @relation(fields: [versionId], references: [id])
  @@unique([versionId, position])
  @@map("checklist_items")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  role         UserRole
  authIdentity String   @unique @map("auth_identity")
  active       Boolean  @default(true)
  events       PieceEvent[]
  attachments  Attachment[]
  labelPrints  LabelPrint[]
  exportBatches ExportBatch[]
  operatorCodes    OperatorCode[]    @relation("operatorCodes")
  issuedCodes      OperatorCode[]    @relation("issuedCodes")
  operatorSessions OperatorSession[] @relation("operatorSessions")
  publishedChecklists ChecklistVersion[]
  inventoryReceived InventoryReceipt[] @relation("receivedBy")
  inventoryCounted  InventoryReceipt[] @relation("countedBy")
  inventoryEvents   InventoryEvent[]
  @@map("users")
}

/// A sign-in credential issued to one operator, by one admin, on purpose.
///
/// One row is either a typed eight-character code or an ID-card badge token,
/// per `kind`. They share this table because everything an admin does with
/// them is identical — issue, list, revoke, and the audit trail of who gave
/// what to whom — and only the shape of the secret and the screen it is
/// entered on differ.
///
/// `codeHash` is a SHA-256 of the normalised secret and is the ONLY copy the
/// system keeps — the plaintext exists once, in the response to the issuing
/// admin, and is unrecoverable afterwards. `last4` is the deliberate exception:
/// four characters is enough for an admin to say "revoke the one ending 9QRX"
/// and far short of what a brute force needs.
model OperatorCode {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  kind       OperatorCredentialKind @default(code)
  codeHash   String    @unique @map("code_hash")
  last4      String    @map("last4")
  issuedById String    @map("issued_by") @db.Uuid
  issuedAt   DateTime  @default(now()) @map("issued_at")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")
  user     User @relation("operatorCodes", fields: [userId], references: [id])
  issuedBy User @relation("issuedCodes", fields: [issuedById], references: [id])
  @@index([userId])
  @@map("operator_codes")
}

/// One signed-in phone. The row is the source of truth, not the cookie: the
/// cookie carries only a random token, so revoking here logs the phone out on
/// its very next request without needing to reach the device.
model OperatorSession {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  tokenHash    String   @unique @map("token_hash")
  deviceLabel  String?  @map("device_label")
  createdAt    DateTime @default(now()) @map("created_at")
  lastSeenAt   DateTime @default(now()) @map("last_seen_at")
  expiresAt    DateTime @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  user User @relation("operatorSessions", fields: [userId], references: [id])
  @@index([userId])
  @@map("operator_sessions")
}

model Worker {
  id     String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name   String
  type   WorkerType
  active Boolean    @default(true)
  pieces Piece[]
  events PieceEvent[]
  @@map("workers")
}

/// A store item the factory receives from outside: zips, wash-care labels, PO
/// labels. `code` is what the phone shows on a chip and what a receipt line
/// keys on; it is fixed after creation. Names carry both languages.
model InventoryItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique
  nameEn    String   @map("name_en")
  nameHi    String   @map("name_hi")
  unit      String   @default("pcs")
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  lines InventoryReceiptLine[]
  @@map("inventory_items")
}

/// One delivery. RECEIVED until the store counts it once; then COUNTED with
/// `hasDiscrepancy` set when any line differs from the paper receipt.
/// `version` is bumped by the count and checked against `expectedVersion`.
model InventoryReceipt {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status         InventoryReceiptStatus @default(RECEIVED)
  supplier       String?
  reference      String?
  location       String?
  note           String?
  hasDiscrepancy Boolean                @default(false) @map("has_discrepancy")
  version        Int                    @default(0)
  receivedById   String                 @map("received_by") @db.Uuid
  receivedAt     DateTime               @default(now()) @map("received_at")
  countedById    String?                @map("counted_by") @db.Uuid
  countedAt      DateTime?              @map("counted_at")
  receivedBy  User  @relation("receivedBy", fields: [receivedById], references: [id])
  countedBy   User? @relation("countedBy", fields: [countedById], references: [id], onDelete: SetNull)
  lines       InventoryReceiptLine[]
  events      InventoryEvent[]
  attachments Attachment[]
  @@index([status, receivedAt(sort: Desc)])
  @@index([receivedById, receivedAt(sort: Desc)])
  @@map("inventory_receipts")
}

model InventoryReceiptLine {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptId    String  @map("receipt_id") @db.Uuid
  itemId       String  @map("item_id") @db.Uuid
  expectedQty  Int?    @map("expected_qty")
  countedQty   Int?    @map("counted_qty")
  addedAtCount Boolean @default(false) @map("added_at_count")
  receipt InventoryReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  item    InventoryItem    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  @@unique([receiptId, itemId])
  @@index([itemId])
  @@map("inventory_receipt_lines")
}

/// Append-only. The idempotency key lives here, as on piece_events, so a
/// retried receive or count replays instead of duplicating.
model InventoryEvent {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptId      String             @map("receipt_id") @db.Uuid
  eventType      InventoryEventType @map("event_type")
  userId         String             @map("user_id") @db.Uuid
  details        Json               @default("{}")
  idempotencyKey String             @unique @map("idempotency_key")
  createdAt      DateTime           @default(now()) @map("created_at")
  receipt InventoryReceipt @relation(fields: [receiptId], references: [id])
  user    User             @relation(fields: [userId], references: [id])
  @@index([receiptId, createdAt])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("inventory_events")
}

/// One row per accepted commercial create (and quantity change), keyed by the
/// request's Idempotency-Key. A retried request finds its key here and gets the
/// same row back instead of a 409 or a duplicate. Piece events carry their own
/// idempotency_key; this table is for everything that is not a piece event.
model MutationKey {
  key       String   @id
  entity    String
  entityId  String   @map("entity_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  @@map("mutation_keys")
}
