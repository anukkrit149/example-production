+// PATCHED (see pnpm.patchedDependencies in the root package.json).
+//
+// Upstream points the `workerd` export condition at ./dist/index.js, a real TCP
+// socket implementation. The OpenNext build traces node_modules under Node, so
+// it follows the `default` condition and only ever copies this file — then
+// esbuild resolves the package under `workerd`, asks for dist/index.js, and
+// fails the build on a file that was never copied.
+//
+// This app does not use pg on Workers at all: @hf/db selects
+// @prisma/adapter-neon there and talks to Postgres over a WebSocket. So the
+// socket is genuinely unreachable in that runtime, and both conditions are
+// pointed here. The throw exists so that if the pg branch ever *is* reached on
+// Workers, it fails loudly and accurately instead of on `undefined`.
+class CloudflareSocket {
+  constructor() {
+    throw new Error(
+      'pg-cloudflare: TCP sockets are not used in this build. On Workers this app connects through @prisma/adapter-neon over WebSocket.',
+    );
+  }
+}
+exports.CloudflareSocket = CloudflareSocket;
